<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<BorderPane fx:id="mainBorderPane" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.gradingsystem.MainWindowController">
    <top>
        <MenuBar>
            <Menu text="Testy">
                <items>
                    <MenuItem text="Nowy" onAction="#showNewTestDialog"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Wyjdź"/>
                </items>
            </Menu>
            <Menu text="Usuń">

            </Menu>
        </MenuBar>
    </top>
    <left>
        <ListView fx:id="testListView">
        </ListView>
    </left>
    <center>
        <VBox style="-fx-background-color: white" alignment="BOTTOM_RIGHT">
            <TextArea fx:id="testDetailsTextArea" VBox.vgrow="ALWAYS"/>
            <Button text="Dodaj wyniki uczniów do sprawdzianu" onAction="#showNewStudentResultsDialog"/>
        </VBox>
    </center>
</BorderPane>
